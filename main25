#include <iostream>
using namespace std;

int main()
{
    // Task: Determine the price of 1 kg of chocolate candies
    // and 1 kg of cookies

    // Variable declaration
    double X, A, Y, B;
    double priceCandy, priceCookies, times;

    // Display a message at the beginning of the task
    cout << "Task: Find the price of 1 kg of candies and cookies" << endl;

    // Input data
    cout << "Enter the weight of candies X: ";
    cin >> X;

    cout << "Enter the price of candies A: ";
    cin >> A;

    cout << "Enter the weight of cookies Y: ";
    cin >> Y;

    cout << "Enter the price of cookies B: ";
    cin >> B;

    // Calculate the price of 1 kg of chocolate candies
    priceCandy = A / X;

    // Calculate the price of 1 kg of cookies
    priceCookies = B / Y;

    // Calculate how many times more expensive candies are than cookies
    times = priceCandy / priceCookies;

    // Display the results
    cout << "Price of 1 kg of candies: " << priceCandy << " UAH" << endl;
    cout << "Price of 1 kg of cookies: " << priceCookies << " UAH" << endl;
    cout << "Candies are " << times << " times more expensive than cookies" << endl;

    return 0;
}
