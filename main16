#include <iostream>
using namespace std;

int main()
{
    // Завдання: Знайти значення функції y = 3x^6 - 6x^2 - 7

    // Оголошення змінних
    double x, y;

    // Відобразити назву завдання
    cout << "Task: Find the value of the function y = 3x^6 - 6x^2 - 7" << endl;

    // Вхідна змінна x
    cout << "Enter x: ";
    cin >> x;

    // Обчислити значення функції
    y = 3 * x * x * x * x * x * x - 6 * x * x - 7;

    // Відобразити результат
    cout << "The value of y: " << y << endl;

    return 0;
}
